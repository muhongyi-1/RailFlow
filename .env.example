# Copy this file to .env and replace ALL CHANGE_ME values before starting services.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_DATABASE=railflow
MYSQL_USER=railflow
MYSQL_PASSWORD=CHANGE_ME_MYSQL
DATABASE_URL=mysql+pymysql://railflow:CHANGE_ME_MYSQL@127.0.0.1:3307/railflow
REDIS_URL=redis://127.0.0.1:6379/0
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=railflow
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ
RAILFLOW_PAYMENT_CALLBACK_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
