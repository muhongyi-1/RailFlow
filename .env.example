# Replace all CHANGE_ME values; Java properties values do not need quotes.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_DATABASE=railflow
MYSQL_USER=railflow
MYSQL_PASSWORD=CHANGE_ME_MYSQL
